# ================= Sentinel environment =================
# Copy to .env and fill real values. NEVER commit .env.
# backend/app/config.py (pydantic-settings) is the ONLY code that reads these.

# --- Deployment shape --------------------------------------------------------
# local: JSON files under INDEX_DIR, in-process API keys, no cloud calls at all.
#        This is what `docker compose up` and `make dev` run.
# aws:   DynamoDB + S3 + SSM. Requires S3_BUCKET_DOCS. Free tier throughout.
STORAGE_BACKEND=local
# Enables POST /v1/demo/chaos and its fault injection. Local only; refused in aws.
DEMO_MODE=true

# --- LLM provider ------------------------------------------------------------
# groq | openai | azure | anthropic | local
LLM_PROVIDER=groq

# Groq (free tier: console.groq.com -> API Keys). Local dev only; in AWS leave
# GROQ_API_KEY empty and set GROQ_API_KEY_SSM_PARAM to an SSM SecureString name.
GROQ_API_KEY=
# GROQ_API_KEY_SSM_PARAM=/sentinel/groq-api-key
GROQ_MODEL_SIMPLE=openai/gpt-oss-20b
GROQ_MODEL_COMPLEX=openai/gpt-oss-120b

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL_SIMPLE=gpt-4o-mini
# OPENAI_MODEL_COMPLEX=gpt-4o

# Azure OpenAI (uses OPENAI_API_KEY as the api-key; models are DEPLOYMENT names)
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_DEPLOYMENT_SIMPLE=
# AZURE_DEPLOYMENT_COMPLEX=

# Anthropic Messages API. Set the model ids your account has access to.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_SIMPLE=
# ANTHROPIC_MODEL_COMPLEX=

# Local / air-gapped (Ollama or vLLM; OpenAI-compatible). `docker compose --profile ollama up`
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_MODEL_SIMPLE=llama3.1:8b
# LOCAL_MODEL_COMPLEX=llama3.1:70b

# Price corrections, per 1M tokens: "provider/model=in:out,..." (see app/llm/pricing.py)
# LLM_PRICING_OVERRIDES=

# --- RAG / index -------------------------------------------------------------
EMBED_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBED_BACKEND=torch                # onnx in containers (same vectors, 60 MB instead of 1.5 GB)
EMBED_THREADS=1                    # onnx threads per query; requests already run in parallel
INDEX_DIR=index                    # local dir holding versioned index + registry + casebook
CHUNK_SIZE_TOKENS=256              # must match all-MiniLM-L6-v2's real max seq length
CHUNK_OVERLAP_TOKENS=48
TOP_K=5                            # chunks handed to synthesizer (kept low: free-tier token/min cap)
CANDIDATES_PER_RETRIEVER=20        # top-N from dense and sparse before RRF
RRF_K=60

# --- agent budgets (hard caps) -----------------------------------------------
TOKEN_BUDGET=10000                 # max LLM tokens per request
DEADLINE_SECONDS=45                # wall-clock cap per request
MAX_ATTEMPTS=2                     # repair attempts before refusal
DOWNGRADE_DEADLINE_SECONDS=8       # below this much time left, use the cheap model
DOWNGRADE_TOKEN_THRESHOLD=2500     # below this many tokens left, use the cheap model
ANSWER_CACHE_TTL_SECONDS=3600      # verified-answer cache; 0 disables

# --- AWS (only read when STORAGE_BACKEND=aws) --------------------------------
AWS_REGION=ap-south-1
S3_BUCKET_DOCS=                    # sentinel-docs-<acct-id>
DDB_TABLE_USERS=sentinel-users
DDB_TABLE_QUOTAS=sentinel-quotas
DDB_TABLE_TRACES=sentinel-traces
DDB_TABLE_DOCUMENTS=sentinel-documents
